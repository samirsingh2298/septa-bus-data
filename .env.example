# Copy to .env and adjust if needed. No API key required for SEPTA's API.
SEPTA_API_BASE_URL=https://www3.septa.org
SEPTA_HTTP_TIMEOUT_SECONDS=10
SEPTA_MAX_RETRIES=3
POLL_CRON=*/5 * * * *

# Paths as seen INSIDE the containers (match the volume mounts in docker-compose.yml)
RAW_DATA_PATH=/app/data/raw
DUCKDB_PATH=/app/data/duckdb/septa.duckdb
