# Pipeline data (regenerated by the pipeline; don't commit live data)
data/raw/
data/duckdb/*.duckdb
data/duckdb/*.duckdb.wal
!data/duckdb/.gitkeep

# Dagster runtime metadata - the Docker setup uses a separate named volume
# for DAGSTER_HOME, but running the CLI locally outside Docker (DAGSTER_HOME
# pointed at this directory) generates these directly here.
dagster_project/dagster_home/
**/dagster_home/
dagster_project/.telemetry/
dagster_project/history/
dagster_project/logs/
dagster_project/schedules/
dagster_project/storage/

# dbt
dbt_project/target/
dbt_project/dbt_packages/
dbt_project/logs/
dbt_project/package-lock.yml
dbt_project/.user.yml

# Python
.venv/
ingestion/.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# env
.env

# logs
*.log

# Claude Code session-local state (not project config)
.claude/

# OS
.DS_Store
